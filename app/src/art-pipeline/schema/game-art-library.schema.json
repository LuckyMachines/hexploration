{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenovoya.com/schemas/game-art-library.schema.json",
  "title": "Xenovoya game art library review contract",
  "type": "object",
  "required": ["version", "artDirectionVersion", "reviewSurfaces", "groups", "enemyTaxonomy", "relicTaxonomy"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "artDirectionVersion": { "type": "string" },
    "reviewSurfaces": { "type": "array", "minItems": 3 },
    "groups": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "target", "columns", "thumbnail", "selectors"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "target": { "type": "integer", "minimum": 1 },
          "columns": { "type": "integer", "minimum": 1, "maximum": 8 },
          "thumbnail": { "type": "string", "pattern": "^\\d{2,4}x\\d{2,4}>?$" },
          "requiredAlpha": { "type": "boolean" },
          "selectors": { "type": "array", "minItems": 1 }
        },
        "additionalProperties": false
      }
    },
    "enemyTaxonomy": { "type": "object" },
    "relicTaxonomy": { "type": "object" }
  },
  "additionalProperties": false
}
