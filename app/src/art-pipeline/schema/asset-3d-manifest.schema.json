{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenovoya.com/schemas/asset-3d-manifest.schema.json",
  "title": "Xenovoya image-to-3D asset manifest",
  "type": "object",
  "required": ["version", "artDirectionVersion", "name", "generation", "trellis", "runtime", "assets"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "artDirectionVersion": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "generation": {
      "type": "object",
      "required": ["provider", "draftModel", "consistencyModel", "sheet", "views"],
      "properties": {
        "provider": { "const": "azure-foundry" },
        "draftModel": { "const": "FLUX.2-pro" },
        "consistencyModel": { "const": "gpt-image-2" },
        "sheet": {
          "type": "object",
          "required": ["width", "height", "columns", "rows", "background"],
          "properties": {
            "width": { "const": 1536 },
            "height": { "const": 1024 },
            "columns": { "const": 3 },
            "rows": { "const": 2 },
            "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
          },
          "additionalProperties": false
        },
        "views": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["id", "yaw", "cell"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "yaw": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
              "cell": { "type": "integer", "minimum": 0, "maximum": 5 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "trellis": {
      "type": "object",
      "required": ["server", "mode", "semanticViewMap", "pipeline", "steps", "sparseResolution", "maxTokens", "textureSize"],
      "properties": {
        "server": { "type": "string", "format": "uri" },
        "mode": { "const": "multiview" },
        "experimentalEvidenceMode": { "const": "multiimage" },
        "semanticViewMap": {
          "type": "object",
          "required": ["front", "right", "back", "left"],
          "properties": {
            "front": { "type": "string" },
            "right": { "type": "string" },
            "back": { "type": "string" },
            "left": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "required": ["maxMaterials", "maxTextures", "allowedRequiredExtensions", "lods"],
      "properties": {
        "maxMaterials": { "type": "integer", "minimum": 1 },
        "maxTextures": { "type": "integer", "minimum": 1 },
        "allowedRequiredExtensions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "lods": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "simplifyRatio", "simplifyError", "textureSize", "maxBytes", "maxTriangles", "maxVertices"],
            "properties": {
              "id": { "type": "string", "pattern": "^lod[0-9]+$" },
              "simplifyRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "simplifyError": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "textureSize": { "type": "integer", "minimum": 1 },
              "maxBytes": { "type": "integer", "minimum": 1 },
              "maxTriangles": { "type": "integer", "minimum": 1 },
              "maxVertices": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sourceAssetId", "seed", "decimationTarget", "cardinalCrop", "physicalBrief"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "sourceAssetId": { "type": "string", "minLength": 1 },
          "seed": { "type": "integer" },
          "decimationTarget": { "type": "integer", "minimum": 10000 },
          "physicalBrief": { "type": "string", "minLength": 1 },
          "matteMode": { "enum": ["soft-color", "connected-border"] },
          "orbitMatteMode": { "enum": ["soft-color", "connected-border"] },
          "cardinalMatteMode": { "enum": ["soft-color", "connected-border"] },
          "cardinalReferenceMode": { "enum": ["all", "identity-only"] },
          "lodSimplifyRatios": {
            "type": "object",
            "propertyNames": { "pattern": "^lod[0-9]+$" },
            "additionalProperties": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          },
          "lodBudgetOverrides": {
            "type": "object",
            "propertyNames": { "pattern": "^lod[0-9]+$" },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "maxBytes": { "type": "integer", "minimum": 1 },
                "maxTriangles": { "type": "integer", "minimum": 1 },
                "maxVertices": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          },
          "materialOverride": {
            "type": "object",
            "properties": {
              "metallicFactor": { "type": "number", "minimum": 0, "maximum": 1 },
              "roughnessFactor": { "type": "number", "minimum": 0, "maximum": 1 },
              "baseColorRemap": {
                "type": "object",
                "required": ["shadow", "highlight"],
                "properties": {
                  "shadow": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                  "highlight": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                  "blackPoint": { "type": "number", "minimum": 0, "maximum": 1 },
                  "whitePoint": { "type": "number", "minimum": 0, "maximum": 1 },
                  "gamma": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "matteFuzzPercent": { "type": "number", "minimum": 0, "maximum": 30 },
          "orbitCrop": {
            "type": "object",
            "properties": {
              "topInset": { "type": "integer", "minimum": 0, "maximum": 255 },
              "rightInset": { "type": "integer", "minimum": 0, "maximum": 255 },
              "bottomInset": { "type": "integer", "minimum": 0, "maximum": 255 },
              "leftInset": { "type": "integer", "minimum": 0, "maximum": 255 }
            },
            "additionalProperties": false
          },
          "cardinalCrop": {
            "type": "object",
            "required": ["layout"],
            "properties": {
              "layout": { "enum": ["2x2", "4x1"] },
              "topInset": { "type": "integer", "minimum": 0 },
              "regions": {
                "type": "object",
                "required": ["front", "right", "back", "left"],
                "additionalProperties": { "$ref": "#/$defs/cropRegion" }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "cropRegion": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 1023 },
        "y": { "type": "integer", "minimum": 0, "maximum": 1023 },
        "width": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "height": { "type": "integer", "minimum": 1, "maximum": 1024 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
