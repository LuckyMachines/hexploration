  "enemyTaxonomy": {
    "targetPerBiome": 2,
    "targetThreatTiers": [
      "ambient",
      "hazard",
      "elite"
    ],
    "requiredStates": [
      "idle",
      "alert",
      "attack",
      "staggered",
      "defeated"
    ],
    "rules": [
      "Silhouette communicates locomotion and threat before color.",
      "Every creature inherits one biome material without becoming a moving prop.",
      "Eyes, mouths, and limbs remain species-specific rather than generically monstrous.",
      "No creature depends on gore, spikes, or red wash to communicate danger."
    ]
  },
