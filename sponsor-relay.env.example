# Sepolia sponsor relay. Never commit the real private key or admin token.
SPONSOR_RELAY_CHAIN_ID=11155111
SPONSOR_RELAY_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SPONSOR_RELAY_FORWARDER_ADDRESS=0x0000000000000000000000000000000000000000
SPONSOR_RELAY_CONTROLLER_ADDRESS=0x0000000000000000000000000000000000000000
SPONSOR_RELAY_BOARD_ADDRESS=0x0000000000000000000000000000000000000000
GAME_AUTHORITY_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
GAME_AUTHORITY_READ_ADDRESSES=0x0000000000000000000000000000000000000000
SPONSOR_RELAYER_PRIVATE_KEY=0x...
SPONSOR_RELAY_ADMIN_TOKEN=replace-with-at-least-32-random-characters
GAME_AUTHORITY_SECRET=replace-with-an-independent-64-character-random-secret
GAME_AUTHORITY_SESSION_SECONDS=2592000
GAME_AUTHORITY_BATCH_WINDOW_MS=175
GAME_AUTHORITY_MAX_BATCH_SIZE=8
GAME_AUTHORITY_PER_IP_HOURLY_SESSIONS=6
GAME_AUTHORITY_PER_IP_HOURLY_READS=3000
SPONSOR_RELAY_ALLOWED_ORIGINS=https://play.xenovoya.com
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
SPONSOR_RELAY_TRUST_PROXY=true
SPONSOR_RELAY_STATE_FILE=/data/sponsor-relay-state.json
SPONSOR_RELAY_CONFIRMATIONS=2
SPONSOR_RELAY_MAX_DEADLINE_SECONDS=900
SPONSOR_RELAY_PER_IP_HOURLY_REQUESTS=120
SPONSOR_RELAY_MAX_IN_FLIGHT=16
SPONSOR_RELAY_LEGACY_API=false
SPONSOR_RELAY_PER_SIGNER_HOURLY_ACTIONS=30
