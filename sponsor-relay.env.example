SPONSOR_RELAY_GLOBAL_DAILY_ACTIONS=500
SPONSOR_RELAY_MAX_GAS_PER_ACTION=2000000
SPONSOR_RELAY_GAS_HEADROOM_BPS=11000
SPONSOR_RELAY_FEE_HEADROOM_BPS=12500
# 10 gwei hard ceiling with a 0.05 gwei tip cap. Normal Sepolia use should be far below this.
SPONSOR_RELAY_MAX_FEE_PER_GAS_WEI=10000000000
SPONSOR_RELAY_MAX_PRIORITY_FEE_PER_GAS_WEI=50000000
