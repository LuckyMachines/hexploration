{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "name", "automatedEvidence", "journeys", "research", "frictionRules", "copy"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "automatedEvidence": {
      "type": "object",
      "required": ["maxAgeDays", "suites"],
      "properties": {
        "maxAgeDays": { "type": "integer", "minimum": 1 },
        "suites": { "type": "array", "minItems": 3 }
      },
      "additionalProperties": false
    },
    "journeys": { "type": "array", "minItems": 2 },
    "research": { "type": "object" },
    "frictionRules": { "type": "array", "minItems": 1 },
    "copy": { "type": "object" }
  },
  "additionalProperties": false
}
