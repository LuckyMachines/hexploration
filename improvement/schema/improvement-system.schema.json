{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenovoya.com/schemas/improvement-system.schema.json",
  "title": "Xenovoya Improvement Control Plane",
  "type": "object",
  "required": ["version", "name", "defaultStaleDays", "promotionStates", "allowedTransitions", "qualityRecordFields", "commands", "surfaces"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "defaultStaleDays": { "type": "integer", "minimum": 1 },
    "promotionStates": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string" } },
    "allowedTransitions": { "type": "object" },
    "qualityRecordFields": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string" } },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["label", "command", "args", "timeoutMs"],
        "properties": {
          "label": { "type": "string" },
          "command": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" } },
          "cwd": { "type": "string" },
          "timeoutMs": { "type": "integer", "minimum": 1000 }
        },
        "additionalProperties": false
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "owner", "weight", "currentGrade", "objective", "stricterABar", "pathPatterns", "evidence", "quickCommands", "fullCommands"]
      }
    }
  },
  "additionalProperties": false
}
