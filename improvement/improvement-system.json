{
  "$schema": "./schema/improvement-system.schema.json",
  "version": "1.5.0",
  "name": "Xenovoya Improvement Control Plane",
  "defaultStaleDays": 14,
  "promotionStates": ["idea", "baseline", "candidate", "verified", "selected", "shipped", "validated", "rework-required", "retired"],
  "allowedTransitions": {
    "idea": ["baseline", "retired"],
    "baseline": ["candidate", "rework-required", "retired"],
    "candidate": ["verified", "rework-required", "retired"],
    "verified": ["selected", "rework-required", "retired"],
    "selected": ["shipped", "rework-required", "retired"],
    "shipped": ["validated", "rework-required", "retired"],
    "validated": ["candidate", "rework-required", "retired"],
    "rework-required": ["candidate", "retired"],
    "retired": []
  },
  "qualityRecordFields": [
    "objective",
    "hypothesis",
    "baseline",
    "evidence",
    "grade",
    "confidence",
    "decision",
    "owner",
    "nextExperiment"
  ],
  "commands": {
    "improvement.tests": {
      "label": "Improvement control-plane tests",
      "command": "node",
      "args": ["--test", "scripts/improvement-control-plane-utils.test.mjs"],
      "timeoutMs": 120000
    },
    "gameplay.scenario-tests": {
      "label": "Scenario utility tests",
      "command": "npm",
      "args": ["run", "scenario:test"],
      "timeoutMs": 120000
    },
    "gameplay.memory-doctor": {
      "label": "Playable Design Memory doctor",
      "command": "npm",
      "args": ["run", "memory:doctor", "--", "--no-build"],
      "timeoutMs": 120000
    },
    "gameplay.sim-refresh": {
      "label": "Refresh flagship gameplay simulation evidence",
      "command": "npm",
      "args": ["run", "sim:golden"],
      "timeoutMs": 300000
    },
    "gameplay.system-tests": {
      "label": "Gameplay improvement, experiment, Oracle, and fun-evidence tests",
      "command": "npm",
      "args": ["run", "gameplay:test"],
      "timeoutMs": 180000
    },
    "gameplay.system-doctor": {
      "label": "Gameplay improvement-system doctor",
      "command": "npm",
      "args": ["run", "gameplay:doctor"],
      "timeoutMs": 120000
    },
    "gameplay.evidence-refresh": {
      "label": "Refresh the complete gameplay evidence dependency graph",
      "command": "npm",
      "args": ["run", "gameplay:refresh"],
      "timeoutMs": 300000
    },
    "gameplay.exact-refresh": {
      "label": "Refresh the canonical exact-engine gameplay matrix on a disposable chain",
      "command": "npm",
      "args": ["run", "gameplay:refresh:exact", "--", "--resume"],
      "timeoutMs": 7200000
    },
    "gameplay.regression-pack": {
      "label": "Run boundary and failure scenarios on a disposable chain",
      "command": "npm",
      "args": ["run", "gameplay:regression", "--", "--resume"],
      "timeoutMs": 1800000
    },
    "board.system-tests": {
      "label": "Board contract, projection, scene-state, and renderer tests",
      "command": "npm",
      "args": ["run", "board:test"],
      "timeoutMs": 180000
    },
    "board.replay-refresh": {
      "label": "Transform exact-engine traces into deterministic board replays",
      "command": "npm",
      "args": ["run", "board:replay"],
      "timeoutMs": 180000
    },
    "board.system-doctor": {
      "label": "Board contract, replay, capture, and performance doctor",
      "command": "npm",
      "args": ["run", "board:doctor"],
      "timeoutMs": 180000
    },
    "board.browser-gates": {
      "label": "Single-canvas board state, input, camera, and performance gates",
      "command": "npm",
      "args": ["run", "board:capture"],
      "timeoutMs": 900000
    },
    "board.cross-browser": {
      "label": "Board interaction and WebGL compatibility in Firefox and WebKit",
      "command": "npm",
      "args": ["run", "board:cross-browser"],
      "timeoutMs": 900000
    },
    "ux.board-tests": {
      "label": "Board quality tests",
      "command": "npx",
      "args": ["vitest", "run", "src/components/board/boardQuality.test.js", "--pool=threads"],
      "cwd": "app",
      "timeoutMs": 120000
    },
    "ux.app-build": {
      "label": "Application production build",
      "command": "npm",
      "args": ["run", "build"],
      "cwd": "app",
      "timeoutMs": 300000
    },
    "ux.density-refresh": {
      "label": "Refresh UI density evidence",
      "command": "npm",
      "args": ["run", "ui:density"],
      "timeoutMs": 120000
    },
    "ux.ui-quality-doctor": {
      "label": "UI visual approval and evidence doctor",
      "command": "npm",
      "args": ["run", "ui:quality:doctor"],
      "timeoutMs": 120000
    },
    "ux.ui-quality-capture": {
      "label": "Rendered UI visual regression suite",
      "command": "npm",
      "args": ["run", "ui:quality"],
      "timeoutMs": 300000
    },
    "ux.ui-quality-cross-browser": {
      "label": "Cross-browser UI quality contracts",
      "command": "npm",
      "args": ["run", "ui:quality:cross-browser"],
      "timeoutMs": 300000
    },
    "ux.ui-quality-report": {
      "label": "Refresh UI quality source-freshness report",
      "command": "npm",
      "args": ["run", "ui:quality:report"],
      "timeoutMs": 120000
    },
    "ux.system-tests": {
      "label": "UX evidence, telemetry, experiment, and friction tests",
      "command": "npm",
      "args": ["run", "ux:test"],
      "timeoutMs": 180000
    },
    "ux.journey-budgets": {
      "label": "First-play and return-play journey budgets",
      "command": "npm",
      "args": ["run", "ux:journeys"],
      "timeoutMs": 300000
    },
    "ux.input-audit": {
      "label": "Keyboard, reflow, forced-color, and reduced-motion audit",
      "command": "npm",
      "args": ["run", "ux:input"],
      "timeoutMs": 300000
    },
    "ux.evidence-refresh": {
      "label": "Refresh journey budgets and UX evidence report",
      "command": "npm",
      "args": ["run", "ux:refresh"],
      "timeoutMs": 360000
    },
    "ux.evidence-doctor": {
      "label": "UX evidence contract doctor",
      "command": "npm",
      "args": ["run", "ux:doctor"],
      "timeoutMs": 120000
    },
    "art.tests": {
      "label": "Art pipeline tests",
      "command": "npm",
      "args": ["run", "art:test"],
      "timeoutMs": 120000
    },
    "art.3d-tests": {
      "label": "Image-to-3D pipeline tests",
      "command": "npm",
      "args": ["run", "art:3d:test"],
      "timeoutMs": 120000
    },
    "art.material-tests": {
      "label": "Material contract and runtime unit tests",
      "command": "npm",
      "args": ["run", "material:test"],
      "timeoutMs": 180000
    },
    "art.material-doctor": {
      "label": "Material provenance, channel, compression, and review doctor",
      "command": "npm",
      "args": ["run", "material:doctor"],
      "timeoutMs": 300000
    },
    "art.material-capture": {
      "label": "Material look-dev and integrated board browser gates",
      "command": "npm",
      "args": ["run", "material:capture"],
      "timeoutMs": 600000
    },
    "art.material-cross-browser": {
      "label": "Material KTX2 compatibility in Firefox and WebKit",
      "command": "npm",
      "args": ["run", "material:cross-browser"],
      "timeoutMs": 600000
    },
    "marketing.doctor": {
      "label": "Marketing readiness doctor",
      "command": "npm",
      "args": ["run", "marketing:doctor"],
      "timeoutMs": 120000
    },
    "marketing.refresh": {
      "label": "Regenerate marketing readiness evidence",
      "command": "node",
      "args": ["scripts/marketing-readiness.mjs"],
      "timeoutMs": 120000
    },
    "reliability.smoke": {
      "label": "Cross-system smoke verification",
      "command": "npm",
      "args": ["run", "verify:smoke"],
      "timeoutMs": 300000
    },
    "reliability.hard": {
      "label": "Hard verification suite",
      "command": "npm",
      "args": ["run", "verify:hard"],
      "timeoutMs": 900000
    },
    "discovery.seo-doctor": {
      "label": "SEO discovery doctor",
      "command": "npm",
      "args": ["run", "seo:doctor"],
      "timeoutMs": 120000
    },
    "discovery.seo-refresh": {
      "label": "Regenerate discovery artifacts",
      "command": "npm",
      "args": ["run", "seo:generate"],
      "timeoutMs": 120000
    }
  },
  "remediations": [
    {
      "id": "refresh-board-evidence",
      "label": "Regenerate exact board replays and board quality evidence",
      "surfaceIds": ["game-board"],
      "actionTypes": ["missing", "invalid", "stale-evidence"],
      "evidencePaths": ["reports/board-system/latest.json"],
      "commandId": "board.replay-refresh",
      "verifyCommandIds": ["board.system-tests", "board.system-doctor"],
      "writePaths": ["reports/board-system/", "app/public/board-system/"],
      "risk": "low",
      "auto": true
    },
    {
      "id": "refresh-gameplay-simulation",
      "label": "Regenerate stale or missing gameplay simulation evidence",
      "surfaceIds": ["gameplay"],
      "actionTypes": ["missing", "invalid", "stale-evidence"],
      "evidencePaths": ["reports/simulator/latest-report.json"],
      "commandId": "gameplay.sim-refresh",
      "verifyCommandIds": ["gameplay.scenario-tests", "gameplay.memory-doctor"],
      "writePaths": ["reports/simulator/", "app/public/simulator/"],
      "risk": "low",
      "auto": true
    },
    {
      "id": "refresh-gameplay-evidence-graph",
      "label": "Regenerate stale or missing gameplay improvement evidence",
      "surfaceIds": ["gameplay"],
      "actionTypes": ["missing", "invalid", "stale-evidence"],
      "evidencePaths": ["reports/gameplay-improvement/latest-report.json"],
      "commandId": "gameplay.evidence-refresh",
      "verifyCommandIds": ["gameplay.system-tests", "gameplay.system-doctor"],
      "writePaths": ["reports/gameplay-improvement/", "reports/simulator/", "reports/bridge/", "reports/fun/", "app/public/gameplay/", "app/public/simulator/", "app/public/bridge/", "app/public/fun/"],
      "risk": "low",
      "auto": true
    },
    {
      "id": "refresh-ui-density",
      "label": "Regenerate stale or missing UI density evidence",
      "surfaceIds": ["ux-onboarding"],
      "actionTypes": ["missing", "invalid", "stale-evidence"],
      "evidencePaths": ["reports/ui-density/latest.json"],
      "commandId": "ux.density-refresh",
      "verifyCommandIds": ["ux.board-tests"],
      "writePaths": ["reports/ui-density/", "app/public/verification/"],
      "risk": "low",
      "auto": true
    },
    {
      "id": "refresh-ui-quality-report",
      "label": "Regenerate stale or missing UI quality evidence without changing visual approvals",
      "surfaceIds": ["ux-onboarding"],
      "actionTypes": ["missing", "invalid", "stale-evidence"],
      "evidencePaths": ["reports/ui-quality/latest.json"],
      "commandId": "ux.ui-quality-report",
      "verifyCommandIds": ["ux.ui-quality-doctor"],
      "writePaths": ["reports/ui-quality/", "app/public/ui-quality/"],
      "risk": "low",
      "auto": true
    },
    {
      "id": "refresh-ux-evidence",
      "label": "Regenerate stale or missing UX journey evidence",
      "surfaceIds": ["ux-onboarding"],
      "actionTypes": ["missing", "invalid", "stale-evidence"],
      "evidencePaths": ["reports/ux/latest.json"],
      "commandId": "ux.evidence-refresh",
      "verifyCommandIds": ["ux.system-tests", "ux.evidence-doctor"],
      "writePaths": ["reports/ux/", "app/public/ux/"],
      "risk": "low",
      "auto": true
    },
    {
      "id": "refresh-marketing-readiness",
      "label": "Regenerate stale or missing marketing evidence",
      "surfaceIds": ["marketing-discovery"],
      "actionTypes": ["missing", "invalid", "stale-evidence"],
      "evidencePaths": ["app/public/marketing/latest-report.json"],
      "commandId": "marketing.refresh",
      "verifyCommandIds": ["marketing.doctor"],
      "writePaths": ["reports/marketing/", "app/public/marketing/"],
      "risk": "low",
      "auto": true
    },
    {
      "id": "refresh-discovery-artifacts",
      "label": "Regenerate stale or missing SEO and discovery evidence",
      "surfaceIds": ["marketing-discovery"],
      "actionTypes": ["missing", "invalid", "stale-evidence"],
      "evidencePaths": ["app/public/seo/latest-report.json"],
      "commandId": "discovery.seo-refresh",
      "verifyCommandIds": ["discovery.seo-doctor"],
      "writePaths": ["reports/seo/", "app/public/seo/", "app/public/sitemap.xml", "app/public/robots.txt", "app/public/llms.txt"],
      "risk": "low",
      "auto": true
    },
    {
      "id": "refresh-verification-evidence",
      "label": "Regenerate stale or missing cross-system verification evidence",
      "surfaceIds": ["technical-reliability", "ops-release"],
      "actionTypes": ["missing", "invalid", "stale-evidence"],
      "evidencePaths": ["reports/verification/latest-hard.json"],
      "commandId": "reliability.smoke",
      "verifyCommandIds": ["reliability.smoke"],
      "writePaths": ["reports/verification/", "app/public/verification/"],
      "risk": "low",
      "auto": true
    }
  ],
  "surfaces": [
    {
      "id": "gameplay",
      "label": "Product and gameplay",
      "owner": "product-design",
      "weight": 1.4,
      "currentGrade": "A-",
      "gradeSource": { "path": "reports/gameplay-improvement/latest-report.json", "jsonPath": "grade" },
      "objective": "Players repeatedly make legible, consequential expedition decisions that produce tension, cooperation, recovery, and memorable outcomes.",
      "stricterABar": "Every flagship scenario passes same-engine simulation, Oracle, feeling-arc, setup-honesty, and observed-player comprehension gates with current evidence.",
      "pathPatterns": ["^contracts/", "^script/", "^scripts/(gameplay|scenario|player-feeling|scenario-time-machine|scenario-lab|scenario-self-driving|playable-design-memory|scenario-evidence-bridge|fun-report|simulator-autotune)", "^(simulator\\.(scenarios|agent-policies|evaluation)|gameplay\\.(quality-contract|experiments))\\.json$"],
      "evidence": [
        { "path": "simulator.scenarios.json", "kind": "source", "required": true, "maxAgeDays": 3650 },
        { "path": "reports/simulator/latest-report.json", "kind": "simulation", "required": true, "maxAgeDays": 14 },
        { "path": "reports/simulator/memory/latest-memory.json", "kind": "memory", "required": false, "maxAgeDays": 14 },
        { "path": "reports/gameplay-improvement/latest-report.json", "kind": "gameplay-improvement-system", "required": true, "maxAgeDays": 14 }
      ],
      "quickCommands": ["gameplay.system-tests", "gameplay.system-doctor"],
      "fullCommands": ["gameplay.system-tests", "gameplay.system-doctor", "gameplay.memory-doctor", "reliability.hard"]
    },
    {
      "id": "game-board",
      "label": "Game board and state expression",
      "owner": "product-engineering",
      "weight": 1.4,
      "currentGrade": "B-",
      "gradeSource": { "path": "reports/board-system/latest.json", "jsonPath": "grade" },
      "objective": "Every exact game state becomes a stable, legible, performant, accessible, and joyful board moment.",
      "stricterABar": "Exact traces replay through one canonical view model and single-canvas renderer; every critical state, input mode, camera rule, asset, frame budget, and mechanic expression passes current evidence.",
      "pathPatterns": ["^app/src/board-system/", "^app/src/components/board/", "^app/src/pages/BoardLabPage", "^app/e2e/board-system", "^scripts/board-system", "^docs/game-board-system"],
      "evidence": [
        { "path": "app/src/board-system/board-system.json", "kind": "board-contract", "required": true, "maxAgeDays": 90 },
        { "path": "app/public/board-system/replays.json", "kind": "exact-board-replays", "required": true, "maxAgeDays": 14 },
        { "path": "reports/board-system/latest.json", "kind": "board-verification", "required": true, "maxAgeDays": 14 },
        { "path": "artifacts/board-system/metrics/latest.json", "kind": "browser-metrics", "required": true, "maxAgeDays": 14 }
      ],
      "quickCommands": ["board.system-tests", "board.system-doctor"],
      "fullCommands": ["board.system-tests", "board.replay-refresh", "board.browser-gates", "board.cross-browser", "board.system-doctor", "ux.app-build"]
    },
    {
      "id": "ux-onboarding",
      "label": "UX, onboarding, and accessibility",
      "owner": "product-design",
      "weight": 1.3,
      "currentGrade": "A-",
      "objective": "A first-time player can understand the board, choose a valid action, predict stakes, and recover from errors without outside explanation.",
      "stricterABar": "Fresh desktop and mobile evidence proves a first meaningful action, readable state hierarchy, keyboard access, reduced motion, and actionable error recovery.",
      "pathPatterns": ["^app/src/(components|hooks|pages|design-system|index\\.css|fonts\\.css|lib/(analytics|uxTelemetry|experiments)|config/experiments)", "^app/e2e/", "^scripts/(ui-quality|game-ui-density|ux-system)", "^ui-quality/", "^ux/", "^docs/(game-ui-readability-audit|ui-quality|ux-)"],
      "evidence": [
        { "path": "docs/game-ui-readability-audit.md", "kind": "audit", "required": true, "maxAgeDays": 30 },
        { "path": "reports/ui-density/latest.json", "kind": "automated-report", "required": true, "maxAgeDays": 14 },
        { "path": "reports/ui-quality/latest.json", "kind": "rendered-quality", "required": true, "maxAgeDays": 14 },
        { "path": "reports/ux/latest.json", "kind": "journey-quality", "required": true, "maxAgeDays": 14 },
        { "path": "ui-quality/visual-approvals.json", "kind": "visual-approval-ledger", "required": true, "maxAgeDays": 30 },
        { "path": "app/test-results", "kind": "visual-proof", "required": false, "maxAgeDays": 14 }
      ],
      "quickCommands": ["ux.board-tests", "ux.ui-quality-doctor", "ux.system-tests", "ux.evidence-doctor"],
      "fullCommands": ["ux.board-tests", "ux.system-tests", "ux.journey-budgets", "ux.input-audit", "ux.ui-quality-capture", "ux.ui-quality-cross-browser", "ux.app-build", "reliability.hard"]
    },
    {
      "id": "visual-art",
      "label": "Visual and art direction",
      "owner": "art-direction",
      "weight": 1.1,
      "currentGrade": "B+",
      "objective": "Every visual asset is recognizable, emotionally purposeful, reusable, provenance-backed, and proven in the live game context.",
      "stricterABar": "Every shipped asset passes contract, joy, context, performance, and promotion gates; 3D assets additionally pass geometry, pivot, LOD, and runtime-lighting review.",
      "pathPatterns": ["^app/public/images/art/", "^app/public/basis/", "^app/src/art-pipeline/", "^app/src/components/board/(ThreeBoard|MaterialPreviewScene|surfaceCatalog|lightingRigs|boardQuality)", "^app/src/pages/MaterialLabPage", "^app/e2e/material-system", "^scripts/(art-|material-)", "^docs/(ART_PIPELINE|MATERIAL_AND_LIGHTING_SYSTEM|material-lighting-system-)\\.md$"],
      "evidence": [
        { "path": "app/src/art-pipeline/asset-manifest.json", "kind": "manifest", "required": true, "maxAgeDays": 30 },
        { "path": "app/src/art-pipeline/asset-3d-review.json", "kind": "review", "required": true, "maxAgeDays": 30 },
        { "path": "app/src/art-pipeline/material-system.json", "kind": "material-contract", "required": true, "maxAgeDays": 90 },
        { "path": "reports/materials/latest.json", "kind": "material-verification", "required": true, "maxAgeDays": 14 },
        { "path": "artifacts/materials/lookdev-material-contact-sheet.png", "kind": "material-lookdev", "required": false, "maxAgeDays": 30 },
        { "path": "artifacts/art/3d/reviews/all-trellis2-method-comparison.png", "kind": "visual-proof", "required": false, "maxAgeDays": 30 }
      ],
      "quickCommands": ["art.tests", "art.3d-tests", "art.material-tests", "art.material-doctor"],
      "fullCommands": ["art.tests", "art.3d-tests", "art.material-tests", "art.material-doctor", "art.material-capture", "art.material-cross-browser", "ux.app-build"]
    },
    {
      "id": "marketing-discovery",
      "label": "Marketing and discovery",
      "owner": "growth",
      "weight": 1,
      "currentGrade": "B",
      "objective": "A new visitor immediately understands the game, sees truthful gameplay proof, and reaches a playable path with measurable intent.",
      "stricterABar": "Fresh public captures and analytics prove the homepage-to-play-to-return funnel across desktop and mobile, with scenario-specific discovery artifacts.",
      "pathPatterns": ["^app/src/pages/HomePage", "^app/src/lib/(analytics|publicRoutes|seo)", "^app/public/(seo|robots|sitemap|site\\.webmanifest)", "^scripts/(growth|generate-seo|marketing)", "^docs/marketing-"],
      "evidence": [
        { "path": "app/public/marketing/latest-report.json", "kind": "automated-report", "required": true, "maxAgeDays": 14 },
        { "path": "docs/marketing-site-report-card.md", "kind": "historical-report-card", "required": false, "maxAgeDays": 30 },
        { "path": "app/public/seo/latest-report.json", "kind": "discovery-report", "required": true, "maxAgeDays": 14 }
      ],
      "quickCommands": ["marketing.doctor", "discovery.seo-doctor"],
      "fullCommands": ["marketing.doctor", "discovery.seo-doctor", "ux.app-build"]
    },
    {
      "id": "technical-reliability",
      "label": "Technical reliability",
      "owner": "engineering",
      "weight": 1.3,
      "currentGrade": "B+",
      "objective": "Builds, tests, simulation, local services, and recovery paths are deterministic, observable, and boring to operate.",
      "stricterABar": "The hard suite passes from a clean checkout, failures identify an owner and recovery command, and no critical evidence is stale.",
      "pathPatterns": ["^scripts/", "^app/vite\\.config", "^app/package", "^package\\.json$", "^Dockerfile$", "^\\.dockerignore$"],
      "evidence": [
        { "path": "reports/verification/latest-hard.json", "kind": "verification", "required": true, "maxAgeDays": 7 },
        { "path": "reports/local-stack/latest-health.json", "kind": "health", "required": false, "maxAgeDays": 7 }
      ],
      "quickCommands": ["reliability.smoke"],
      "fullCommands": ["reliability.hard"]
    },
    {
      "id": "ops-release",
      "label": "Operations and release",
      "owner": "engineering",
      "weight": 1,
      "currentGrade": "B",
      "objective": "Every release candidate has traceable verification, rollback information, runtime health proof, and an explicit promotion decision.",
      "stricterABar": "A release cannot become shipped without exact-stack evidence, browser coverage, security headers, rollback instructions, and post-release validation.",
      "pathPatterns": ["^Dockerfile$", "^\\.dockerignore$", "^app/public/_headers$", "^app/public/_redirects$", "^scripts/run-local-stack", "^scripts/verify-hard", "^\\.github/"],
      "evidence": [
        { "path": "reports/verification/latest-hard.json", "kind": "release-verification", "required": true, "maxAgeDays": 7 },
        { "path": "app/public/_headers", "kind": "release-config", "required": true, "maxAgeDays": 90 }
      ],
      "quickCommands": ["reliability.smoke"],
      "fullCommands": ["reliability.hard"]
    },
    {
      "id": "player-validation",
      "label": "Observed player validation",
      "owner": "product-research",
      "weight": 1.4,
      "currentGrade": "C",
      "objective": "Real-player behavior validates comprehension, delight, pacing, cooperation, return intent, and the moments automation cannot judge.",
      "stricterABar": "At least five recent representative sessions cover first play and return play, with observation notes, consent-safe evidence, severity, and incorporated decisions.",
      "pathPatterns": ["^improvement/records/playtests\\.json$", "^docs/playtest"],
      "evidence": [
        { "path": "improvement/records/playtests.json", "kind": "human-observation", "required": true, "maxAgeDays": 30, "minimumRecords": 5 }
      ],
      "quickCommands": ["improvement.tests"],
      "fullCommands": ["improvement.tests"]
    },
    {
      "id": "improvement-system",
      "label": "Improvement system",
      "owner": "product-operations",
      "weight": 1.2,
      "currentGrade": "A-",
      "objective": "Every meaningful change begins with a falsifiable hypothesis and ends with evidence, a decision, a promotion state, and one ranked next action.",
      "stricterABar": "One command detects impacted surfaces, runs proportionate checks, compares the previous baseline, measures system effectiveness, and records a portfolio snapshot with no stale critical evidence.",
      "pathPatterns": ["^improvement/", "^scripts/improvement-control-plane", "^docs/improvement-system", "^package\\.json$", "^\\.gitignore$"],
      "evidence": [
        { "path": "improvement/improvement-system.json", "kind": "quality-contract", "required": true, "maxAgeDays": 90 },
        { "path": "docs/improvement-system-report-card.md", "kind": "report-card", "required": true, "maxAgeDays": 30 },
